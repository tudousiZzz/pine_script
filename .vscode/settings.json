{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.associations": {
        "*.pine": "pine"
    },
    "editor.rulers": [120],
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/node_modules": true
    },
    "[pine]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    }
}
